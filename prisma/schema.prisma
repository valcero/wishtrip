generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Destination {
  id       String  @id @default(uuid())
  name     String
  country  String
  timezone String
  places   Place[]
}

enum PlaceCategory {
  ATTRACTION
  RESTAURANT
  NATURE
  SHOPPING
  NIGHTLIFE
}

enum CostLevel {
  FREE
  BUDGET
  MID_RANGE
  PREMIUM
}

model Place {
  id                     String                 @id @default(uuid())
  destinationId          String
  destination            Destination            @relation(fields: [destinationId], references: [id])
  name                   String
  description            String
  category               PlaceCategory
  latitude               Float
  longitude              Float
  defaultDurationMinutes Int
  estimatedCost          CostLevel
  url                    String?
  imageUrl               String?
  openingHours           PlaceOpeningHours[]
  interests              PlaceInterest[]
  travellerTypes         PlaceTravellerType[]
  itineraryActivities    ItineraryActivity[]
}

model PlaceOpeningHours {
  id        String @id @default(uuid())
  placeId   String
  place     Place  @relation(fields: [placeId], references: [id])
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime  String // "HH:MM"
  closeTime String // "HH:MM"
}

model Interest {
  id     String          @id @default(uuid())
  name   String // "Food", "Culture", "Nature"
  places PlaceInterest[]
}

model PlaceInterest {
  placeId    String
  interestId String
  place      Place    @relation(fields: [placeId], references: [id])
  interest   Interest @relation(fields: [interestId], references: [id])

  @@id([placeId, interestId])
}

model TravellerType {
  id     String               @id @default(uuid())
  name   String // "Solo", "Couple", "Family", "Friends"
  places PlaceTravellerType[]
}

model PlaceTravellerType {
  placeId         String
  travellerTypeId String
  place           Place         @relation(fields: [placeId], references: [id])
  travellerType   TravellerType @relation(fields: [travellerTypeId], references: [id])

  @@id([placeId, travellerTypeId])
}

// -----------------------------------------
// STEP 4: Itinerary Persistence Models
// -----------------------------------------

model Itinerary {
  id                  String         @id @default(uuid())
  createdAt           DateTime       @default(now())
  
  // Trip Request parameters saved for context
  origin              String
  destination         String
  startDate           String
  endDate             String
  partySize           Int
  travellerType       String
  pace                String
  budget              String
  interests           String[]

  // AI Narrative
  personalizedSummary String?

  // Relationships
  days                ItineraryDay[]
}

model ItineraryDay {
  id          String              @id @default(uuid())
  itineraryId String
  itinerary   Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  
  dayNumber   Int
  date        String
  theme       String?
  description String?

  activities  ItineraryActivity[]
}

model ItineraryActivity {
  id              String       @id @default(uuid())
  dayId           String
  day             ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  
  placeId         String
  place           Place        @relation(fields: [placeId], references: [id])
  
  name            String
  startTime       String
  endTime         String
  durationMinutes Int
  reason          String
  estimatedCost   CostLevel
  category        PlaceCategory
}
